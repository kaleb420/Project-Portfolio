#ifdef UTEST
#include <complete.h>
#if MILESTONE_8 == 1
#define USERSPACE
#include <blib.h>
#include <testing.h>
REGISTER(DYNAMIC_ALLOCATION, 8, malloc_tests, suites, 2);
//          NAME MS        FUNC  SUITES, NUM_SUITES


static test_suite_t suites[] = {
  {
    .section = "Malloc",
    .prompts = {
      "Allocation removed from list",
      "Returns correct address",
      "Handles multiple allocations",
      "Returns error on bad request",
      "Can fill available heap",
      "Correctly handles gaps",
      "Handles perfect fits"
    }
  },
  {
    .section = "Free",
    .prompts = {
      "Free list maintains order",
      "Handles multiple disjoint blocks",
      "Handles end of list free",
      "Free list reordered as needed",
      "Allocation coalesces upward",
      "Allocation coalesces downward",
      "Allocation coalesces both ways"
    }
  },
};

#define REAL_SIZE(x) (sizeof(alloc_t) + x)

static alloc_t* lastfree;
static void validate_list(i32 phase, i32 test, alloc_t* head, u64* expected, u64* sizes, u32 len) {
  for (u32 i=0; i<len; i++) {
    if (assert(head != NULL, &suites[phase].results[test], "s", "FAIL - freelist points to NULL prematurely")) {
      alloc_t* alloc = ((alloc_t*)(expected[i])) - 1;
      assert(head == alloc, &suites[phase].results[test], "s", "FAIL - List out of order or includes invalid ptr");
      assert(head->size == sizes[i], &suites[phase].results[test], "s", "FAIL - Free block in list is incorrect size");
      head = head->next;
    }
  }
  assert(head == lastfree, &suites[phase].results[test], "s", "FAIL - freelist did not end at the expected address");
}

static i32 validate_alloc(u64 size, u64 remaining, u64 ptr, u64 expected) {
  i32 valid = 1;
  alloc_t* alloc = ((alloc_t*)ptr) - 1;
  if (ptr == NULL)
    return 0;
  
  valid &= assert(ptr == expected, &suites[0].results[1], "s", "FAIL - Returned pointer did not match expected address");
  valid &= assert(alloc->size == size, &suites[0].results[1], "s", "FAIL - Returned allocation is not marked with the correct size");
  if (remaining) {
    valid &= assert(freelist == (alloc_t*)(ptr + size), &suites[0].results[0], "s",
		    "FAIL - Freelist not moved to correct offset after alloc");
    valid &= assert(freelist->size > (remaining - 1), &suites[0].results[0], "s",
		    "FAIL - Allocation removed too many bytes from freelist");
    valid &= assert(freelist->size < (remaining + 1), &suites[0].results[0], "s",
		    "FAIL - Allocation removed too few bytes from freelist");
  }
  else
    valid &= assert(freelist == NULL, &suites[0].results[0], "s", "FAIL - Freelist was not set to NULL on empty heap");
  return valid;
}


static void userspace_tests(void) {
  /*  -----------------  Malloc Tests ------------------- */
  init_heap(HEAP_SIZE);
  alloc_t* origin, *rel = freelist;
  u64 ptr[10];
  u64 reserved = 0, heapsz = freelist->size;
  origin = freelist;

  ptr[0] = (u64)malloc(5);
  reserved += REAL_SIZE(5);
  validate_alloc(5, heapsz - reserved, ptr[0], (u64)(rel + 1));

  rel = freelist;
  ptr[1] = (u64)malloc(1024);
  reserved += REAL_SIZE(1024);
  assert(validate_alloc(1024, heapsz - reserved, ptr[1], (u64)(rel + 1)), &suites[0].results[2],
	 "s", "FAIL - Second allocation was not correctly reserved");

  rel = freelist;
  ptr[2] = (u64)malloc(5000);
  reserved += REAL_SIZE(5000);
  assert(validate_alloc(5000, heapsz - reserved, ptr[2], (u64)(rel + 1)), &suites[0].results[2],
	 "s", "FAIL - Extra allocations were not correctly reserved");

  rel = freelist;
  ptr[3] = (u64)malloc(400);
  reserved += REAL_SIZE(400);
  assert(validate_alloc(400, heapsz - reserved, ptr[3], (u64)(rel + 1)), &suites[0].results[2],
	 "s", "FAIL - Extra allocations were not correctly reserved");

  rel = freelist;
  ptr[4] = (u64)malloc(heapsz);
  assert(ptr[4] == NULL, &suites[0].results[3], "s", "FAIL - Allocation larger than remaining size returned non-NULL");

  rel = freelist;
  ptr[4] = (u64)malloc(heapsz - reserved);
  assert(validate_alloc(heapsz - reserved, 0, ptr[4], (u64)(rel + 1)), &suites[0].results[4],
	 "s", "FAIL - Allocating all remaining space failed");
  
  u8* badptr = malloc(5);
  assert(badptr == NULL, &suites[0].results[3], "s", "FAIL - Allocation returned when mallocing bytes after heap is exhausted");
  

  /*  ------------------- Free Tests --------------------- */
  freelist = origin;
  freelist->size = heapsz;
  freelist->next = NULL;
  alloc_t* base = freelist;
  u64 sizes[] = { 400, 12, 82, 1024, 38, 555, 7000, 80000, 40, 1234 };

  for (i32 i=0; i<10; i++)
    ptr[i] = (u64)malloc(sizes[i]);

  lastfree = freelist;

  free((void*)ptr[2]);
  validate_list(1, 0, freelist, (u64[]){ ptr[2] }, (u64[]){ sizes[2] }, 1);
  
  free((void*)ptr[7]);
  validate_list(1, 1, freelist, (u64[]){ ptr[2], ptr[7] }, (u64[]){ sizes[2], sizes[7] }, 2);
  
  free((void*)ptr[0]);
  validate_list(1, 3, freelist, (u64[]){ ptr[0], ptr[2], ptr[7] }, (u64[]){ sizes[0], sizes[2], sizes[7] }, 3);

  free((void*)ptr[6]);
  u64 new_sizes[3];
  new_sizes[0] = sizes[0];
  new_sizes[1] = sizes[2];
  new_sizes[2] = sizes[6] + REAL_SIZE(sizes[7]);
  validate_list(1, 4, freelist, (u64[]){ ptr[0], ptr[2], ptr[6] }, new_sizes, 3);

  free((void*)ptr[3]);
  new_sizes[1] += REAL_SIZE(sizes[3]);
  validate_list(1, 5, freelist, (u64[]){ ptr[0], ptr[2], ptr[6] }, new_sizes, 3);

  free((void*)ptr[1]);
  new_sizes[0] += REAL_SIZE(new_sizes[1]) + REAL_SIZE(sizes[1]);
  new_sizes[1] = new_sizes[2];
  validate_list(1, 6, freelist, (u64[]){ ptr[0], ptr[6] }, new_sizes, 2);

  free((void*)ptr[9]);
  new_sizes[2] = sizes[9];
  lastfree = ((alloc_t*)ptr[9]) - 1;
  validate_list(1, 2, freelist, (u64[]){ ptr[0], ptr[6] }, new_sizes, 2);

  ptr[0] = (u64)malloc(100);
  // Validate
  alloc_t* alloc = ((alloc_t*)ptr[0]) - 1;
  assert(alloc->size == 100, &suites[0].results[5], "s", "FAIL - Reallocated block was incorrect size");
  assert(alloc == base, &suites[0].results[5], "s", "FAIL - New allocation was not placed in newly freed block");

  free((void*)ptr[0]);
  validate_list(1, 0, freelist, (u64[]){ ptr[0], ptr[6] }, new_sizes, 2);

  u64 new_size = base->size;
  ptr[0] = (u64)malloc(base->size);
  new_sizes[0] = new_sizes[1];
  alloc = ((alloc_t*)ptr[0]) - 1;
  assert(alloc->size == new_size, &suites[0].results[6], "s", "FAIL - Reallocated block was incorrect size");
  assert(alloc == base, &suites[0].results[6], "s", "FAIL - New allocation was not placed in newly freed block");
  validate_list(0, 6, freelist, (u64[]){ ptr[6] }, new_sizes, 1);
}



static void malloc_tests([[gnu::unused]] override_t* shadows) {
  void init_interrupts(void);
  init_interrupts();
  void user_start(void (*fn)(void));
  user_start(userspace_tests);
}

#endif
#endif
