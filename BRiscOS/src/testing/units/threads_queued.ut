static void resume_queued_tests([[gnu::unused]] override_t* sh) {
  shadows = sh;
  i64 (*test_fn)(u32) = resume;
  shadows[RESCHED].precall = spoof_resched;
  shadows[LIST_INSERT_THREAD].precall = spoof_list_insert;
  shadows[LIST_DEQUEUE_THREAD].precall = spoof_list_dequeue;
  shadows[LIST_REMOVE_THREAD].precall = spoof_list_remove;

  
}

static void suspend_queued_tests([[gnu::unused]] override_t* sh) {
  shadows = sh;
  i64 (*test_fn)(u32) = suspend;
  shadows[RESCHED].precall = spoof_resched;
  shadows[LIST_INSERT_THREAD].precall = spoof_list_insert;
  shadows[LIST_DEQUEUE_THREAD].precall = spoof_list_dequeue;
  shadows[LIST_REMOVE_THREAD].precall = spoof_list_remove;

  
  
}

