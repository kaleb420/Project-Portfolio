#include <blib.h>
#include <testing.h>
#include <wrapper_defs.h>

REGISTER(RESUME_QUEUED, 5, resume_queued_tests, resume_queued_suites, 1);
REGISTER(SUSPEND_QUEUED, 5, suspend_queued_tests, suspend_queued_suites, 1);

static test_suite_t resume_queued_suites[] = {
  {
    .section = "General",
    .prompts = {
      "Thread added to queue"
    }
  }
};

static test_suite_t suspend_queued_suites[] = {
  {
    .section = "General",
    .prompts = {
      "Thread removed from queue"
    }
  }
};

