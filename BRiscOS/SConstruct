import os, random, shutil

__version__ = ""
try:
    with open(".version") as f:
        ls = f.read().split("=")
        if len(ls) != 2 or ls[0].strip() != "kernel_version":
            print("WARNING - Version file contained unreadable value, this could indicate a damaged repository")
        else:
            __version__ = ls[1].strip()
except OSError:
    print("WARNING - Failed to open version file, this could indicate a damage repository")

def error(code, msg):
    print(msg)
    Exit(code)

AddOption("--no-git", dest="nogit", action="store_true", help="Disable automatic git management, this can be useful for scripting")
AddOption("--mode", action="store", choices=["loaded", "debug", "metal"], default="loaded",
          help="Set which mode of execution should be performed when loading the requested target")
AddOption("--port", type=int, default=random.Random(os.environ["USER"]).randint(5570, 7000),
          help="When used with the [gdb] target or in '--mode=debug', explicitly declares the gdb port to be used (use when the default "
          "port is currently in use by another user)")
AddOption("--logfile", type=str)

Help(f"""

  BRiscOS build tools [version {__version__}]

usage: scons <target> [--debug] [--mode={{loaded,debug,metal}}] [--port=PORT] [--no-git]
       scons -c

options:
  -c, --clean   Remove all of the files generated by previous builds.  This
                acts as a hard reset in the case were the  build tools ever
                fail to compile the most recent copy of your files.

  --mode        Sets how the target should be handled when executed.
                'loaded' - QEMU starts with the uboot  bootloader and  runs
                           the kernel as a real PE image. [Default]
                'metal'  - QEMU  starts with the kernel  loaded immediately
                           without an intermediary bootloader
                'debug'  - As 'metal', but QEMU starts a gnu debugger (gdb)
                           server to enable line-by-line debugging 
                           (see 'gdb' target)

  --port        Explicitly run the gdb server/client  on the requested port.
                For use when the default port is already in use.

  --no-git      Disables the  automatic git  registration when checking out
                new  files.   Useful if using a script or checking  out old
                milestones.

description: Runs the scons build tools. 

Targets:
  checkout
      usage: scons checkout milestone=MILESTONE [--no-git]

      options:
        MILESTONE   A number  between 1 and 10 indicating the  milestone to
                    generate.

      description: Checks out the code  necessary for a requested milestone
                   if the file already exists, you will be prompted to keep
                   or replace the file.

  build
    usage: scons [build] [milestone=MILESTONE]

    descrption: Builds the image  from the source files.  This  target will
                build two  products, a `kernel.bin`  and `tests.img`  which
                are used by the `run` and `test` targets respectively.

  run
    usage: scons run [--mode] [--port=PORT]

    description: Run the kernel in the QEMU virtual machine.  If the kernel
                 kernel  doesn't  exist, it  will  first  run `scons build`
                 automatically.

  test
    usage: scons test [--mode] [--port=PORT]

    description: Run the  unit test  kernel  in the QEMU  virtual  machine.
                 This  will display  the output of  custom unit  tests that
                 examine the implementation of the current milestone.
           note: This target runs in --mode=metal by default.

  gdb
    usage: scons gdb [--port=PORT]

    description: Connect a gdb debugging session with the currently running
                 kernel  in  'debug'  mode.  This will  allow  you to  step
                 through your kernel line by line using the gnu debugger.
""")

_libc = "linux-gnu" if shutil.which("riscv64-unknown-linux-gnu-gcc") else "elf"

arch      = ARGUMENTS.get('arch', f"riscv64-unknown-{_libc}")
builder   = ".conscript"
build_dir = ".build"
ld_file   = os.path.join("src", "img.ld")
map_file  = File(os.path.join(build_dir, "img.map"))

PORT = ARGUMENTS.get("port", random.Random(os.environ["USER"]).randint(5570, 7000))
logfile = GetOption("logfile")
logfile = f",logfile={logfile}" if logfile else ""

CC     = "-".join([arch, "gcc"])
cflags = "-std=gnu2x -Wall -Werror -Wpedantic -Wextra -Wparentheses -Winfinite-recursion -Wmisleading-indentation -Wuninitialized -Wduplicated-branches -Wduplicated-cond -Wshadow -Wcast-align -Wconversion -Wlogical-op -Winvalid-pch -fno-zero-initialized-in-bss -fno-builtin -nostdlib -nostdinc -march=rv64imac_zicsr -mabi=lp64 -mcmodel=medany -O0 -g "
LD     = "-".join([arch, "ld"])
lflags = f"-nostdlib -Map {map_file} -T {ld_file} "
AS     = "-".join([arch, "as"])
aflags = "-march=rv64imac_zicsr -mabi=lp64 -g "
QEMU   = "qemu-system-riscv64"
qflags = f"-M virt -chardev stdio,id=uart0{logfile} -serial chardev:uart0 -display none"
bflags = "-bios .loader/u-boot.bin -device virtio-blk-pci,drive=vd0 -drive file=fat:rw:./.loader/efi,format=raw,media=disk,id=vd0"
GDB    = "-".join([arch, "gdb"])

env = Environment(CC=CC, AS=AS, LINK=LD, QEMU=QEMU, GDB=GDB, LINKFLAGS=lflags, memmap=map_file, qflags=qflags, port=PORT, ARCH=arch)
env["bflags"] = bflags
env["milestone"] = "0"
if not any([env.GetOption(c) for c in ["clean", "help"]]):
    try:
        env["tmilestone"] = env["milestone"] = ARGUMENTS["milestone"]
    except KeyError:
        if "checkout" in COMMAND_LINE_TARGETS:
            error(-1 ,"[Error] Cannot checkout code without explicit `milestone=#` argument")
        try:
            with open(".msfile", 'r') as f:
                env["milestone"] = ARGUMENTS.get("milestone", f.read().split('\n')[0])
        except OSError as exp:
            while True:
                cont = input("\n[WARNING] Trying to build without defining a milestone, continue? [Y/n] ")
                if not cont or cont in ['Y', 'y', 'yes']: break
                if cont and cont in ['n', 'N', 'no']: Exit(-1)


def do_checkout(target, source, env):
    with open(".msfile", 'w') as f:
        f.write(str(env["milestone"]))

    for fname in os.listdir(".setup"):
        parts = fname.split('-')
        if parts[0] == "milestone" and parts[1] == env["milestone"]:
            out_file = os.path.join("src", *parts[2:])
            try: os.makedirs(os.path.join("src", *parts[2:-1]))
            except OSError: pass

            print(f"-- Checking out file: {out_file}")
            if os.path.isfile(out_file):
                while (resp := input(" '{out_file}' exists, would you like to replace this file? [y/N]")) not in ['', 'y', 'Y', 'n', 'N']: pass
                if resp in ['n', 'N', '']: continue
            shutil.copy2(os.path.join(".setup", fname), out_file)
            if not env.GetOption("nogit"):
                print(f"    Adding file to git")
                os.system(f"git add {out_file}")
    try: os.makedirs(os.path.join("src", "testing"))
    except OSError: pass
    with open(os.path.join("src", "testing", "include", "complete.h"), 'w') as f:
        f.write("#ifndef COMPLETE_H\n#define COMPLETE_H\n")
        for n in range(1, int(env["milestone"]) + 1):
            f.write(f"#define MILESTONE_{n} 1\n")
        for n in range(int(env["milestone"]) + 1, 11):
            f.write(f"#define MILESTONE_{n} 0\n")
        f.write("#endif\n")
        
env["BUILDERS"]["Checkout"] = env.Builder(action=do_checkout)
env.Alias("checkout", env.Checkout("checkout_runner", None))

def do_gdb(target, source, env):
    f = os.path.join(".build", ("test" if "test" in COMMAND_LINE_TARGETS else "img"), "kernel.elf")
    os.system(f'{env["GDB"]} -ex "file {f}" -ex "target remote :{env.GetOption("port")}"')
    env.Exit(0)

def do_pack(target, source, env):
    os.system("tar -czvf source.tar.gz src")
    env.Exit(0)

if env.GetOption("mode") == "debug":
    env['qflags'] += f" -S -gdb tcp::{env.GetOption('port')}"

env["BUILDERS"]["Pack"] = env.Builder(action=do_pack)
env.Alias("pack", env.Pack("tarball", None))
          
env["BUILDERS"]["GDB"] = env.Builder(action=do_gdb)
env.Alias("gdb", env.GDB("gdb_runner", None))

env.Append(ENV={"PATH": os.environ["PATH"]}, CFLAGS=cflags, ASFLAGS=aflags)
env.SConscript(".conscript-img", variant_dir=os.path.join(".build", "img"), duplicate=0, exports='env')
env.SConscript(".conscript-test", variant_dir=os.path.join(".build", "test"), duplicate=0, exports='env')
